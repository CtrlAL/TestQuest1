<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HomeLibrary</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Books" asp-action="Index">HomeLibrary</a>
                <ul class="navbar-nav">
                    <li><a class="nav-link" asp-area="" asp-controller="Books" asp-action="Index">Книги</a></li>
                    <li><a class="nav-link" asp-area="" asp-controller="Books" asp-action="Create">Добавить</a></li>
                </ul>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main">
            @if (TempData["StatusMessage"] is string status && status.Length > 0)
            {
                <p class="status-message">@status</p>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            &copy; 2026 - HomeLibrary
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
